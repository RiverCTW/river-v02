# River v0.21 production configuration
HOST=0.0.0.0
PORT=8792
NODE_ENV=production
RIVER_DB_PATH=/data/river-v0.2.sqlite
RIVER_ADMIN_USERNAME=admin
RIVER_ADMIN_PASSWORD=change-this-before-first-start
# Stable server-only key used to encrypt short-lived background job credentials.
# RIVER_GENERATION_SECRET=replace-with-a-long-random-secret

# Optional provider base URLs. API keys remain device-local and are never stored here.
# DEEPSEEK_BASE_URL=https://api.kakouai.com
# OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
