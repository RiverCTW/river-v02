# River v0.2 production configuration
HOST=0.0.0.0
PORT=8792
NODE_ENV=production
RIVER_DB_PATH=/data/river-v0.2.sqlite
RIVER_ADMIN_USERNAME=admin
RIVER_ADMIN_PASSWORD=change-this-before-first-start

